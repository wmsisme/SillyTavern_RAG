*.zip
*.7z
*.rar
credentials.json
service-account.json

# ==================== 本项目：后端 / 前端 本地数据（勿提交） ====================
# 用户上传的图片等静态资源（角色卡图片就在这里）
backend/static/
# SQLite 业务数据（角色卡 / 世界书），属于用户数据，不进公开仓库
backend/data.db
backend/data.db-journal
backend/data.db-wal

# 密钥文件：只允许提交 .env.example 模板，.env 永不入库
# （索引更新.py 会执行 `git add .`，这条是防止明文 Key 被推到公开仓库的关键）
.env
.env.local
!.env.example

# ChromaDB 持久化目录：体积大且含二进制索引。
# 注意：RAG/chroma_db/chroma.sqlite3 是历史遗留的已跟踪文件，
# 本规则只拦截新文件；要让规则对旧文件生效需 `git rm --cached`。
RAG/chroma_db/

# 索引升级 / 重建前的备份目录
RAG/backup/

# Trae IDE 工作目录（内含执行方案文档，按需手动提交）
.trae/

# 账号里存的 LLM Key 的加密密钥（丢了 = 用户存的 Key 全解不开，要单独备份）
backend/.secret_key

# 向量缓存/断点：体积大且是本地生成物，一律不进库（原来只写了精确文件名，加后缀的没被拦住）
RAG/vector_cache*.npz
RAG/vector_cache_meta*.json
RAG/rebuild_*_partial.npz

# 容器部署的绑定挂载目录（SQLite 与用户图片，绝不能进仓库）
/data/
/static/
