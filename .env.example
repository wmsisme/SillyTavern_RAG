# 复制本文件为 .env 并填值。.env 已被 .gitignore 拦住，不会进仓库。
#
# ⚠️ 注意：`.env` 必须放在**项目根目录**。配置模块在导入时就加载它，
#    所以任何一项改了都要**重启后端**才生效（写错了也不会报错，只会读不到）。

# ==================== 必填 ====================

# 加密「用户存进账号里的 LLM Key」的密钥（Fernet，32 字节 urlsafe base64）。
# 生成一个： python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ 丢了 = 所有用户存的 Key 全部解不开（界面会提示重填）；换机器/重建容器都要带上同一个值。
# 不填也能跑：会自动生成 backend/.secret_key 并在本地持久化（适合单机开发）。
SECRET_KEY=

# 向量化 + 精排用的硅基流动 Key（bge-m3 / bge-reranker-v2-m3 在硅基流动是免费档）。
# 注册：cloud.siliconflow.cn → API 密钥。实名后才能用免费模型。
SILICONFLOW_API_KEY=

# ==================== 检索层 ====================
# local       = 本机 RAG/bge-large-zh（要装 torch，且要搬 3.4GB 模型）
# siliconflow = 走硅基流动 API（推荐；服务器只要 2 核 4G，不用搬模型）
EMBED_PROVIDER=siliconflow

# 换模型必须重建索引（两套向量不在同一空间）：
#   python tools/rebuild_index_api.py --dry-run   # 先试 20 条
#   python tools/rebuild_index_api.py             # 全量（支持断点续传）
# SILICONFLOW_EMBED_MODEL=BAAI/bge-m3
# SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ==================== 数据位置（容器部署时指向挂载卷） ====================
# DB_PATH=/data/data.db
# STATIC_DIR=/data/static
# RAG_DIR=/app/RAG

# ==================== 限流（每 IP 每分钟 50 次，只算贵接口） ====================
# RATE_LIMIT_PER_MIN=50
# RATE_LIMIT_AUTH_PER_MIN=10      # 登录注册更严一档，防撞密码
# RATE_LIMIT_ANON_PER_MIN=30      # 未登录访客更严一档（检索/工具箱不需要登录，但都在花站长的额度）
# RATE_LIMIT_ENABLED=1
# ⚠️ 只有「反向代理不在本机、uvicorn 的 --proxy-headers 也拿不到真实 IP」时才设 1；
#    默认 0（不信任客户端伪装的 X-Forwarded-For）。
# TRUST_PROXY=0

# ==================== 注册开关 ====================
# 留空 = 开放注册；填了就必须带邀请码
# REGISTER_INVITE_CODE=

# ==================== 出网安全（2026-10-07 加） ====================
# 用户自带的大模型地址（BYOK 的 base_url）只允许指向公网，
# 内网/环回/云元数据地址一律拒绝 —— 否则就是个「让服务器替我发请求」的开关（SSRF）。
# LLM_MAX_CONCURRENT=8            # 同时在途的外部调用上限（防慢速请求把线程池占满）

# ==================== 接口文档 & 安全响应头 ====================
# ENABLE_DOCS=0                   # 1 = 打开 /docs /redoc /openapi.json（**公网别开**，等于送一份接口地图）
# CSP_ENABLED=1                   # 0 = 关掉 CSP（万一页面样式因此异常时的应急开关）

# ==================== 可选覆盖项 ====================
# 服务端自己的 DeepSeek Key —— 现在**只有离线灌库脚本**用得上。
# 用户的 AI 问答/生成走 BYOK（他们自己的 Key 或存进自己账号的 Key），不碰这一个。
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# COOKIE_SECURE=1                 # 强制给会话 Cookie 加 Secure（https 下会自动加，一般不用手动设）
# EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5

# ---- 日志（2026-10-08 新增）--------------------------------------------
# 统一日志：同时写控制台与轮转文件 logs/app.log。出问题先看那个文件。
# 请求日志记 方法/路径/状态码/耗时/IP/请求ID，**不记**请求体、查询串、Cookie、
# 任何 header 的值（用户的 API Key 就在 header 里）。
# LOG_LEVEL=INFO          # DEBUG / INFO / WARNING / ERROR
# LOG_TO_FILE=1           # 设 0 则只写控制台（本机调试用）
# LOG_MAX_MB=10           # 单个日志文件上限
# LOG_BACKUPS=5           # 保留几份历史
# LOG_DIR=                # 默认 <项目>/logs
# REQUEST_SLOW_MS=3000    # 超过这个耗时的请求单独打 WARNING

# ---- 邮件告警（2026-10-08 新增）----------------------------------------
# 服务端错误（5xx）与前端错误会**主动发邮件通知站长**，不用再等他翻日志。
# 4xx（打错路径、没登录、被限流）**不告警** —— 那类噪音会把真问题淹掉。
# ⚠️ SMTP_PASS 是**邮箱授权码**（不是登录密码），属于密钥：只放 .env，
#    不要写进这里，更不要提交进仓库（.env 已在 .gitignore 里）。
# 没配置时整套告警静默跳过，不影响服务运行。
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465               # 465 = SSL；587 会走 STARTTLS
# SMTP_USER=你的邮箱@qq.com
# SMTP_PASS=邮箱授权码
# ALERT_TO=收件邮箱（留空则发给自己）
# ALERT_COOLDOWN_SECONDS=300  # 同一个报警 key 的冷却时间
# ALERT_MAX_PER_WINDOW=3      # 全局速率上限：这个窗口内最多几封
# ALERT_WINDOW_SECONDS=600

# ---- 反馈附件（2026-10-08）--------------------------------------------
# 用户在反馈时能上传文件（投递技术档案之类）。**五道闸门全在这几个变量里**：
# 单文件大小 / 每次个数 / 每 IP 每天 / 每用户累计 / 全局总量。
# 顾虑是「服务器是我的电脑，放不了那么多东西」—— 所以总量那道是兜底：
# 只限「每 IP 每天」挡不住磁盘被很多个 IP 慢慢填满。
# 到了上限会拒绝上传（拒绝理由会原样显示给用户），后台也能看到用量。
# 文件落在 backend/static/attachments/（该目录不进 git）；类型白名单写在代码里。
# ATTACH_MAX_FILE_MB=20        # 单个文件上限
# ATTACH_MAX_PER_SUBMIT=3      # 一次最多传几个
# ATTACH_MAX_PER_IP_PER_DAY=5  # 同一个 IP 每天最多传几个
# ATTACH_MAX_PER_USER=50       # 单个用户累计上限
# ATTACH_MAX_TOTAL_MB=1024     # 全部附件总量上限（兜底那道）
