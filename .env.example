# 复制本文件为 .env 并填值。.env 已被 .gitignore 拦住，不会进仓库。
#
# ⚠️ 注意：`.env` 必须放在**项目根目录**。配置模块在导入时就加载它，
#    所以任何一项改了都要**重启后端**才生效（写错了也不会报错，只会读不到）。

# ==================== 必填 ====================

# 加密「用户存进账号里的 LLM Key」的密钥（Fernet，32 字节 urlsafe base64）。
# 生成一个： python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ 丢了 = 所有用户存的 Key 全部解不开（界面会提示重填）；换机器/重建容器都要带上同一个值。
# 不填也能跑：会自动生成 backend/.secret_key 并在本地持久化（适合单机开发）。
SECRET_KEY=

# 向量化 + 精排用的硅基流动 Key（bge-m3 / bge-reranker-v2-m3 在硅基流动是免费档）。
# 注册：cloud.siliconflow.cn → API 密钥。实名后才能用免费模型。
SILICONFLOW_API_KEY=

# ==================== 检索层 ====================
# local       = 本机 RAG/bge-large-zh（要装 torch，且要搬 3.4GB 模型）
# siliconflow = 走硅基流动 API（推荐；服务器只要 2 核 4G，不用搬模型）
EMBED_PROVIDER=siliconflow

# 换模型必须重建索引（两套向量不在同一空间）：
#   python tools/rebuild_index_api.py --dry-run   # 先试 20 条
#   python tools/rebuild_index_api.py             # 全量（支持断点续传）
# SILICONFLOW_EMBED_MODEL=BAAI/bge-m3
# SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ==================== 数据位置（容器部署时指向挂载卷） ====================
# DB_PATH=/data/data.db
# STATIC_DIR=/data/static
# RAG_DIR=/app/RAG

# ==================== 限流（每 IP 每分钟 50 次，只算贵接口） ====================
# RATE_LIMIT_PER_MIN=50
# RATE_LIMIT_AUTH_PER_MIN=10      # 登录注册更严一档，防撞密码
# RATE_LIMIT_ENABLED=1
# ⚠️ 只有「反向代理不在本机、uvicorn 的 --proxy-headers 也拿不到真实 IP」时才设 1；
#    默认 0（不信任客户端伪装的 X-Forwarded-For）。
# TRUST_PROXY=0

# ==================== 注册开关 ====================
# 留空 = 开放注册；填了就必须带邀请码
# REGISTER_INVITE_CODE=

# ==================== 可选覆盖项 ====================
# 服务端自己的 DeepSeek Key —— 现在**只有离线灌库脚本**用得上。
# 用户的 AI 问答/生成走 BYOK（他们自己的 Key 或存进自己账号的 Key），不碰这一个。
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# COOKIE_SECURE=1                 # HTTPS 部署时设 1（http 下设 1 浏览器不会存 Cookie）
# EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
